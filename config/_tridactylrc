"x" -*- mode: js-ts; comment-start: "\"x\"" -*-
"example file" https://raw.githubusercontent.com/tridactyl/tridactyl/master/.tridactylrc
"clean up" review `:viewconfig autocmds` from time to time & autocmddelete unused entries

set theme auto
set hintautoselect false
set tabclosepinned false

blacklistadd www.fastmail.com
blacklistadd betaapp.fastmail.com
blacklistadd www.inoreader.com

blacklistadd outlook.office.com

"for jira"
unbind w
unbind a
unbind m
autocmd DocStart .+atlassian[.]net/.+jql=ORDER.+ urlmodify -Q jql
autocmd DocStart .+atlassian[.]net/.+linkSource=.+ urlmodify -Q linkSource
autocmd DocStart .+atlassian[.]net/.+sourceType=.+ urlmodify -Q sourceType
  autocmd HistoryState https://outlook.+ js document.querySelectorAll("a[href*=\"atlOrigin\"], a[href*=\"icft\"]")?.forEach(a => {a.search=""; a.hash=""; a.title=""})
autocmd DocLoad https://git.+ js document.querySelectorAll("a[href*=\"atlOrigin\"]")?.forEach(a => {a.search=""; a.title=""})

  unbind <C-e>

  bind <C-Space> scrollpage -0.5
    bind <Space> scrollpage 0.5

bind ` tabsort --url

autocmd DocStart .+utoronto[.]ca.~cks.space.blog.+ js document.querySelector(".commenttools a")?.click()

setpref browser.aboutConfig.showWarning false
setpref browser.warnOnQuitShortcut false

setpref toolkit.legacyUserProfileCustomizations.stylesheets true
setpref ui.key.menuAccessKey 0
setpref browser.compactmode.show true
setpref browser.toolbars.bookmarks.visibility "never"
setpref browser.uidensity 1
setpref sidebar.verticalTabs true
setpref browser.tabs.groups.enabled true
setpref browser.tabs.inTitlebar 0
setpref browser.tabs.insertAfterCurrent true
setpref browser.tabs.loadDivertedInBackground true
setpref browser.tabs.hoverPreview.showThumbnails false
setpref findbar.highlightAll true
setpref intl.regional_prefs.use_os_locales true
setpref layout.testing.overlay-scrollbars.always-visible true
setpref widget.gtk.overlay-scrollbars.enabled false

setpref browser.download.autohideButton false
setpref browser.newtabpage.activity-stream.showSearch false
setpref browser.sessionstore.restore_pinned_tabs_on_demand true
setpref browser.startup.page 3
setpref browser.ml.chat.enabled false
setpref browser.ml.enable false
setpref extensions.ml.enabled false

setpref layout.spellcheckDefault 0
setpref layout.css.always_underline_links true
setpref browser.display.use_document_fonts 0
setpref devtools.defaultColorUnit "hsl"
setpref browser.visited_color "oklch(from mediumorchid l 0.7 h)"
setpref browser.visited_color.dark "oklch(from palegoldenrod 0.7 c h)"
setpref reader.color_scheme "dark"
setpref devtools.theme "dark"
setpref view_source.wrap_long_lines true
setpref font.language.group "x-unicode"
setpref font.default.x-unicode "sans-serif"
setpref font.default.x-western "sans-serif"
setpref font.name.monospace.x-unicode "JuliaMono Nerd Font"
setpref font.name.monospace.x-western "JuliaMono Nerd Font"
