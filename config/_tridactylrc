"" vim: set filetype=vim
"" -*- mode: js-ts -*-
"" example file https://raw.githubusercontent.com/tridactyl/tridactyl/master/.tridactylrc

set theme auto
set hintautoselect false
set tabclosepinned false

blacklistadd www.fastmail.com
blacklistadd betaapp.fastmail.com
blacklistadd jp.inoreader.com
blacklistadd www.inoreader.com

blacklistadd outlook.office.com
autocmd DocLoad https:[/]/outlook.office.com/.* js tri.browserBg.tabs.insertCSS({ code: "#LeftRail, #OwaTitleBar, #SearchAnswerTop+div {display: none !important;} #TopBar { float:left!important; }", cssOrigin: "user"})

autocmd DocLoad https://www[.]linkedin[.]com/.* js tri.browserBg.tabs.insertCSS({ code: "aside {display:none!important;}" , cssOrigin: "user"})


" " for jira
unbind w
unbind .
unbind a
unbind m
autocmd DocLoad https:[/]/.*[.]atlassian[.]net/.* js tri.browserBg.tabs.insertCSS({ code: "#ak-jira-navigation {display: none !important;}", cssOrigin: "user"})

unbind <C-e>

bind <C-Space> scrollpage -0.5
bind <Space> scrollpage 0.5

bind ` tabsort --url

"" autocmd DocStart .* js tri.browserBg.tabs.insertCSS({ code: "a:visited {color: VisitedText !important;} iframe[src*='google.com/gsi'] { display: none !important }", allFrames: true, cssOrigin: "user"})
autocmd DocLoad  .* js tri.browserBg.tabs.insertCSS({ code: "a:visited {color: VisitedText !important;} iframe[src*='google.com/gsi'] { display: none !important }", allFrames: true, cssOrigin: "user"})
