setpref font.name.sans-serif.x-western "FiraGO"
setpref font.name.serif.x-unicode "BabelStone Han Basic"
setpref font.name.serif.x-western "BabelStone Han Basic"
setpref font.name-list.emoji "Twitter Color Emoji,Twemoji Mozilla"
setpref browser.translations.neverTranslateLanguages "vi,fi"
setpref browser.translations.mostRecentTargetLanguages "en"
setpref browser.urlbar.quicksuggest.scenario	"history"
setpref browser.urlbar.shortcuts.bookmarks	false
setpref browser.urlbar.shortcuts.history	false
setpref browser.urlbar.shortcuts.tabs	false
setpref browser.urlbar.suggest.engines	false
setpref browser.urlbar.suggest.pocket	false
setpref browser.urlbar.suggest.topsites	false

setpref network.cookie.CHIPS.enabled true
setpref network.http.network_error_logging.enabled true
setpref browser.crashReports.unsubmittedCheck.autoSubmit2 true
setpref dom.security.https_only_mode false
setpref dom.webgpu.enabled true
setpref webgl.dxgl.enabled true
setpref image.jxl.enabled true
setpref security.OCSP.enabled false
setpref signon.rememberSignons false
