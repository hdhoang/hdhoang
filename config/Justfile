set unstable := true
set shell := ["nu", "-m", "light", "-c"]

default:
    just --list

start:
    ~/homes/config/start.sh

up:
    # tool sync
    flatpak -u update -y
    cargo iu
    run0 --description=upgrade --nice=12 dnf --setopt=install_weak_deps=False upgrade -y

sway_tree PATTERN:
    swaymsg -t get_tree -r|rg -i {{ PATTERN }}

mu PATH:
    mpv --no-resume-playback --vo=null --no-video --no-ytdl --osd-level=3 --scripts=gh/mpv-mpris/mpris.so --shuffle --playlist=rclone-cache --playlist={{ PATH }} --volume=64 --replaygain=track --cache=yes --cache-pause-wait=30 --cache-pause-initial=yes

[working-directory: 'rclone-cache/cp']
yt:
        #!/bin/env fish
        yt-dlp --format=250/251/140/hls-400/vorbis/aac-hi/bestaudio --remux-video='mkv>opus/webm>opus' --prefer-free-formats --download-archive ~/yta.txt --cookies ~/ytc.txt -a ~/q.org --no-mtime --parse-metadata='%(format)s %(format_id)s:%(meta_format)s' --embed-metadata --playlist-random --compat-options=filename-sanitization --output="%(uploader)s/%(title)s [%(id)s].%(ext)s" --exec=after_move:'sleep %(upload_date>%y|2)q' --color=stderr:always 2>| tee /dev/fd/2 | rg -m1 --color=always again.later
        rsgain easy --preset=ebur128 --skip-existing -m 3 .

[no-cd]
cl repo:
    jj git clone --colocate {{ repo }}

[no-cd]
t *params:
    cargo nextest run {{ params }}

[no-cd]
d *paths:
    try { jj diff {{ paths }} err> /dev/null } catch { git diff -- {{ paths }} err> /dev/null }
