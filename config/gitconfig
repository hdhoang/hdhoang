# -*- mode: toml-ts -*-

[includeIf "hasconfig:remote.*.url:git@gitlab.com:*"]
path = ~/homes/config/jj_config.toml
[includeIf "hasconfig:remote.*.url:https://gitlab.com/*"]
path = ~/homes/config/jj_config.toml
[includeIf "hasconfig:remote.*.url:git@github.com:*"]
path = ~/homes/config/jj_config.toml
[includeIf "hasconfig:remote.*.url:https://github.com/*"]
path = ~/homes/config/jj_config.toml

[includeIf "gitdir:~/repos/"]
path = ~/repos/whoami.toml

[advice]
detachedHead = false

[core]
abbrev = 12
attributesfile = ~/homes/.gitattributes
excludesfile = ~/homes/config/ignore_global
autocrlf = true
editor = "emacsclient -c"

[alias]
pmc = "push --push-option=merge_request.create --push-option=merge_request.squash --push-option=merge_request.remove_source_branch --push-option=merge_request.auto_merge origin"

[protocol]
version = 2
[init]
defaultBranch = "v0"

[branch]
sort = -committerdate

[fetch]
showForcedUpdates = true
prune = true
fsckobjects = true

[transfer]
fsckobjects = true
[receive]
fsckobjects = true

[pull]
rebase = true
twohead = ort

[checkout]
workers = 12

[rerere]
enabled = true

[rebase]
autoStash = true
updateRefs = true

[merge]
autoStash = true
conflictStyle = zdiff3
keepbackup = false

[merge "mergiraf"]
name = mergiraf
driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P

[log]
date = iso

[diff "elisp"]
# https://www.jamescherti.com/better-git-diff-emacs-lisp-elisp/
xfuncname = ^\\([^[:space:]]*def[^[:space:]]+[[:space:]]+([^()[:space:]]+)

[diff]
algorithm = histogram
indentHeuristic = true
mnemonicPrefix = true
renames = copies

external = difft
colorMoved = dimmed-zebra
colorMovedws = allow-indentation-change

tool = diff
[difftool]
prompt = false
